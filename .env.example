# ==============================================================================
# MoveInSync Review Intelligence AI - Environment Variables
# ==============================================================================
# Copy this file to .env and populate your credentials if AI analysis is desired.
# Do NOT commit .env to version control!

# OpenAI API Key (Optional: Required only for AI-assisted classification and LLM synthesis)
# Leave blank or commented to operate in 100% deterministic, rule-based mode.
OPENAI_API_KEY=

# Optional: Default target Play Store Application Package ID
PLAY_STORE_APP_ID=com.moveinsync.ets

# Optional: Default collection country and language
DEFAULT_COUNTRY=in
DEFAULT_LANGUAGE=en
